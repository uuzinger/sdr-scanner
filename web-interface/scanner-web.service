[Unit]
Description=scanner-web — browser front end for the Loudoun scanner archive
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
User=scanner
Group=scanner
WorkingDirectory=/opt/scanner-web
EnvironmentFile=/opt/scanner-web/.env
ExecStart=/opt/scanner-web/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8080 --proxy-headers
Restart=on-failure
RestartSec=5
# trunk-recorder is the priority on this box
Nice=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
